{
    "name": "breakfast/website",
    "description": "Breakfast \u2014 a small British web studio. Kirby 5 website and operational platform (CRM, enquiries, Hermes integration).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "getkirby/cms": "~5.5.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.68"
    },
    "autoload": {
        "psr-4": {
            "Breakfast\\Platform\\": "site/plugins/breakfast-platform/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Breakfast\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "getkirby/composer-installer": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    }
}
