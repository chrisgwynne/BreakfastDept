# Dependencies (installed via composer / npm)
/vendor/
/kirby/
/node_modules/

# Secrets — never commit
/.env
/.env.*
!/.env.example

# Kirby-generated media (thumbs, resized images)
/public/media/*
!/public/media/.gitkeep

# Operational storage — sessions, cache, logs, flat-file data, private uploads, queue
# Encrypted-secret master key — MUST NEVER be committed.
/storage/secret.key
/storage/sessions/*
/storage/cache/*
/site/cache/*
/storage/logs/*
/storage/accounts/*
# Flat-file data tree — every operational record (CRM, projects, portal, queue,
# audit, …) lives here and MUST NEVER be committed.
/storage/data/*
/storage/uploads/*
/storage/queue/*
/storage/client-previews/*
# Secure portfolio originals (regenerated from committed seed assets / uploads).
/storage/portfolio/*
# Kirby writes sessions/accounts under site/ when those roots aren't relocated.
/site/sessions/*
/site/accounts/*
!/storage/**/.gitkeep
!/site/sessions/.gitkeep

# Panel accounts (Kirby user files) must never be committed
/site/accounts/

# Build / test artefacts
/public/assets/css/*.map
/.phpunit.cache/
/.php-cs-fixer.cache
/coverage/
/playwright-report/
/test-results/
/playwright/.cache/

# Local tooling phars fetched on-demand (not vendored)
/phpunit.phar
/phpstan.phar
/php-cs-fixer.phar

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Superseded static site + FTP sync artefacts
/public_html/

# Local test tool binaries (real tools come from composer.lock)
/tools/
/test-results/
/playwright-report/

# Never track scratch/temp artifacts.
/tmp/

# Standalone admin app — deps and build output (built in CI, shipped by deploy)
/admin/node_modules/
/admin/*.tsbuildinfo
/admin/tsconfig.tsbuildinfo
/public/breakfast-admin/
/storage/invoices/*
/storage/proposals/*
/storage/contracts/*
/storage/receipts/*
/storage/client-files/*
/storage/vault-keys/*
/storage/change-requests/*
