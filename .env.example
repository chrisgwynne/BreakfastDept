# Breakfast platform — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only placeholders belong in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: development | production
APP_ENV=development
# Set false in production. Controls Kirby debug + verbose errors.
APP_DEBUG=true
# Public base URL, no trailing slash.
APP_URL=http://localhost:8000
# Short opaque string bumped on deploy; shown in the health endpoint.
APP_VERSION=dev

# ---------------------------------------------------------------------------
# Breakfast Admin — the Kirby Panel is relocated to this private slug and
# rebranded. Lowercase [a-z0-9-]. This is a discoverability control, NOT a
# security boundary: auth, permissions, CSRF and server-side authorisation
# still apply. The old /panel address returns 404. Keep this out of robots.txt
# and public links. Default: breakfast-admin
# ---------------------------------------------------------------------------
BREAKFAST_ADMIN_SLUG=breakfast-admin

# ---------------------------------------------------------------------------
# Panel self-signup installer. Off in production by default. Set to true JUST
# long enough to create your first admin from the web (visit the admin slug),
# then set back to false. It only appears while there are zero users.
# ---------------------------------------------------------------------------
PANEL_INSTALL=false

# ---------------------------------------------------------------------------
# Kirby licence (buy at getkirby.com). Leave blank in development.
# ---------------------------------------------------------------------------
KIRBY_LICENSE=

# ---------------------------------------------------------------------------
# Database (SQLite lives OUTSIDE the public docroot)
# ---------------------------------------------------------------------------
CRM_DB_PATH=storage/database/crm.sqlite

# ---------------------------------------------------------------------------
# Mail — provider selection. brevo | smtp | fake | null
# Dev/test default to 'fake' so no real email is ever sent by accident.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=fake
# From/reply addresses (also editable, non-secret, in Panel site settings)
MAIL_FROM=studio@example.com
MAIL_FROM_NAME=Breakfast
# Where internal enquiry notifications land
MAIL_ENQUIRIES_TO=studio@example.com

# SMTP transport (only used when MAIL_PROVIDER=smtp). Passwords are env-only.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURITY=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Brevo transactional email (only used when MAIL_PROVIDER=brevo).
# API keys are ENVIRONMENT-ONLY — never in Kirby content or the Panel.
# ---------------------------------------------------------------------------
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3

BREVO_SENDER_NAME=Breakfast
BREVO_SENDER_EMAIL=hello@example.com
BREVO_REPLY_TO_NAME=Breakfast
BREVO_REPLY_TO_EMAIL=hello@example.com

# Optional Brevo-hosted template IDs. If blank, the app renders HTML+text itself.
BREVO_INTERNAL_ENQUIRY_TEMPLATE_ID=
BREVO_ENQUIRY_ACK_TEMPLATE_ID=
BREVO_CRM_EMAIL_TEMPLATE_ID=
BREVO_TASK_REMINDER_TEMPLATE_ID=
BREVO_DAILY_DIGEST_TEMPLATE_ID=
BREVO_FAILED_JOB_TEMPLATE_ID=

# Webhook authentication (shared secret preferred; Basic auth optional).
BREVO_WEBHOOK_SECRET=
BREVO_WEBHOOK_BASIC_AUTH_USER=
BREVO_WEBHOOK_BASIC_AUTH_PASSWORD=

# Tracking OFF by default (privacy-conscious). Enable deliberately.
BREVO_TRACK_OPENS=false
BREVO_TRACK_CLICKS=false

# Optional marketing contact sync — OFF by default. The SQLite CRM is the
# source of truth; sync only contacts with a recorded lawful basis.
BREVO_CONTACT_SYNC_ENABLED=false
BREVO_MARKETING_LIST_ID=

# ---------------------------------------------------------------------------
# Hermes integration — server-to-server, HMAC signed. SECRETS ONLY HERE.
# Generate with: php bin/console hermes:keys --create <label>
# Format: HERMES_KEY_<ID>=<scopes>|<base64-secret>
#   scopes are comma-separated, e.g. content:read,crm:summary,crm:notes
# ---------------------------------------------------------------------------
HERMES_ENABLED=false
# Reject requests whose timestamp is outside this many seconds (replay window).
HERMES_REPLAY_WINDOW=300
# Example credential (replace ID + secret; delete this line in real deployments):
# HERMES_KEY_hermes-primary=content:read,content:draft,crm:summary,crm:read,crm:notes,crm:tasks,crm:classify,webhooks:test|REPLACE_WITH_BASE64_SECRET

# ---------------------------------------------------------------------------
# Outbound webhooks — signing secret for payloads Breakfast SENDS to Hermes
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
# Comma-separated destination URLs (or configure in Panel, non-secret)
WEBHOOK_ENDPOINTS=

# ---------------------------------------------------------------------------
# Analytics — none | plausible | ga4  (default: none)
# ---------------------------------------------------------------------------
ANALYTICS_PROVIDER=none
ANALYTICS_SITE=
ANALYTICS_SCRIPT_URL=

# ---------------------------------------------------------------------------
# Client Previews — static mock-up hosting on a SEPARATE origin.
# The preview origin MUST NOT share cookies with the admin/main site. In
# production, point CLIENT_PREVIEW_BASE_URL/HOST at a dedicated host (see
# docs/client-preview-deployment.md). Leave blank in dev to use the path prefix
# below (documented as INSUFFICIENT isolation — local use only).
# ---------------------------------------------------------------------------
# Per-preview origin isolation (PREFERRED). Set to a wildcard zone, e.g.
# preview.breakfastdept.com — each preview is then served on its OWN origin,
# {slug}.preview.breakfastdept.com, so one preview can never read another.
# Requires wildcard DNS (*.preview…) + a wildcard TLS cert. See
# docs/client-preview-deployment.md. Leave blank to use the single-host/path
# fallbacks below.
CLIENT_PREVIEW_WILDCARD_BASE=
CLIENT_PREVIEW_SCHEME=https

# Single shared preview host (used only when WILDCARD_BASE is blank).
CLIENT_PREVIEW_BASE_URL=
CLIENT_PREVIEW_HOST=
CLIENT_PREVIEW_DEV_PREFIX=_preview

# Server-side caps. Editors can never raise these from the UI.
CLIENT_PREVIEW_MAX_ZIP_MB=50
CLIENT_PREVIEW_MAX_EXTRACTED_MB=250
CLIENT_PREVIEW_MAX_FILE_MB=25
CLIENT_PREVIEW_MAX_FILES=3000
CLIENT_PREVIEW_MAX_DIRECTORY_DEPTH=20
CLIENT_PREVIEW_MAX_VERSIONS=10
CLIENT_PREVIEW_DEFAULT_EXPIRY_DAYS=30
CLIENT_PREVIEW_ANALYTICS_RETENTION_DAYS=180
CLIENT_PREVIEW_TEMP_RETENTION_HOURS=24
# Allow .mp4/.webm inside previews (off by default).
CLIENT_PREVIEW_ALLOW_VIDEO=false

# ---------------------------------------------------------------------------
# Data retention (days). 0 = keep forever (that category is never pruned).
# Applied by `bin/console retention:cleanup --confirm` (see deploy/cron.example).
# ---------------------------------------------------------------------------
RETENTION_ACTIVITIES_DAYS=730
RETENTION_PREVIEW_ANALYTICS_DAYS=180
RETENTION_QUEUE_DAYS=30
RETENTION_WEBHOOK_DAYS=90
RETENTION_EMAIL_EVENTS_DAYS=90
RETENTION_AUDIT_DAYS=365
# Grace before an unreferenced file/dir is treated as an orphan.
RETENTION_ORPHAN_GRACE_HOURS=24

# ---------------------------------------------------------------------------
# Uploads (start-a-project form). Stored OUTSIDE the docroot.
# ---------------------------------------------------------------------------
UPLOADS_ENABLED=false
UPLOADS_MAX_BYTES=5242880
# Optional external malware scanner command; receives the file path as $1.
# Leave blank to use the built-in no-op scanner interface.
UPLOADS_SCANNER_CMD=
