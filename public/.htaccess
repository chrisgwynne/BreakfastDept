# Breakfast — Apache configuration for the public/ document root.
# Everything above this directory (content, site, storage, vendor, .env) is
# outside the web root and must NOT be served. If your host cannot use a
# public/ docroot, see deploy/apache.conf.example for a rewrite-based fallback.

# Disable directory listings.
Options -Indexes -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Uncomment and set if the site is served from a subfolder.
    # RewriteBase /

    # ------------------------------------------------------------------
    # Canonical host: force https://www.breakfastdept.com for the public
    # marketing site so there is exactly ONE indexable origin (the apex,
    # www, http and https variants all 301 here — matching the canonical
    # tags and sitemap). Scoped by host so the separate client-preview
    # origins (*.preview.breakfastdept.com) and any admin host are never
    # touched. X-Forwarded-Proto is honoured so we never loop behind a
    # TLS-terminating proxy (LiteSpeed/CDN talking plain HTTP to origin).
    # ------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^breakfastdept\.com$ [NC]
    RewriteRule ^ https://www.breakfastdept.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.breakfastdept\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://www.breakfastdept.com%{REQUEST_URI} [L,R=301]

    # Block dotfiles (.env, .git, etc.) — these should not be here anyway.
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Route everything else to Kirby's front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Media, assets: long-lived immutable caching (filenames are cache-busted).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML entrypoint: revalidate on every use rather than never storing it.
    # `no-cache` (not `no-store`) keeps the response out of shared/proxy caches
    # while still allowing Chrome's back/forward cache — so clicking a link and
    # hitting Back is an instant restore, not a full round trip. bfcache restores
    # the response and its per-request CSP nonce together, so inline scripts stay
    # valid; `must-revalidate` forces a fresh nonce on any real reload.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Baseline security headers (the app also sets a per-request CSP with a nonce
    # on its HTML responses; these are server-level defence in depth).
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    # HSTS — only meaningful over HTTPS (browsers ignore it on plain HTTP). The
    # site is HTTPS-only with an HTTP->HTTPS redirect, so it is safe to always
    # send. Remove `preload` until you have submitted the domain to the HSTS
    # preload list.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Strip the framework/runtime fingerprint.
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # Suppress the server product/version banner where the runtime allows it
    # (LiteSpeed/Apache honour this; some builds pin Server and ignore it).
    Header always unset Server
    Header unset Server
</IfModule>

# Compression.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Never execute or serve content/site/storage even if mis-symlinked here.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|env|log)$">
    Require all denied
</FilesMatch>
